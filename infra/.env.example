# Copie para `infra/.env` e preencha. NUNCA versione o .env real (.gitignore).
# Valores abaixo sao ficticios e servem apenas de exemplo.

# --- Borda publica ---
# Dois hostnames, dois regimes: o de conteudo e somente leitura e serve o
# aparelho; o do CMS e autenticado e serve o operador.
CONTENT_DOMAIN=conteudo.exemplo.invalid
CMS_DOMAIN=cms.exemplo.invalid
ACME_EMAIL=ops@exemplo.invalid

# --- Storage de packs (MinIO) ---
MINIO_ROOT_USER=guiaubs
MINIO_ROOT_PASSWORD=troque-esta-senha

# --- Chave de assinatura de packs (Ed25519) ---
# SPOF critico do modelo de ameacas (PRD 4.2 / risco R4): em producao vive em
# cofre offline/HSM e so o job `packer` (sem porta) a monta, read-only, depois
# do dual review. Nunca em CI. Enquanto a VPS nao existe, vale a excecao
# provisoria da Revisao do ADR-001 (spec/stack.md, 10).
# Em dev, gere um par descartavel:
#   openssl genpkey -algorithm ed25519 -out contract/keys/dev-k1.pem
#   openssl pkey -in contract/keys/dev-k1.pem -pubout -out contract/keys/pack-signing-k1.pub
PACK_SIGNING_KEY_PATH=./contract/keys/dev-k1.pem
PACK_SIGNING_KEY_ID=k1

# --- Plano de controle (cms) ---------------------------------------------
# Gere cada um com: openssl rand -base64 48
#
# BETTER_AUTH_SECRET cifra o segredo TOTP em repouso. Trocar este valor
# INVALIDA o segundo fator de todo mundo — nao e rotacao, e reset.
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-de-48-bytes-em-base64
# IP_HASH_SALT pseudonimiza o IP na trilha e o e-mail na trava de login. Sem
# sal, sha256 de IPv4 se inverte por forca bruta em minutos.
IP_HASH_SALT=troque-por-outro-valor-aleatorio-de-48-bytes-em-base64
# URL publica do CMS — e ela que o NAVEGADOR usa, entao aponta para o edge.
#
# Faz DUAS coisas, e a segunda e facil de nao perceber: define a origem confiavel
# na validacao de CSRF, e decide sozinha se o cookie de sessao sai com `Secure` e
# o prefixo `__Secure-` — o Better Auth deriva as duas de este valor comecar com
# `https://`, e `NODE_ENV=production` nao socorre.
#
# Por isso `loadEnv()` DERRUBA o processo se, em producao, este valor nao for
# `https://`. O exemplo abaixo e de desenvolvimento, onde o edge fala HTTP.
BETTER_AUTH_URL=http://127.0.0.1:8082

# --- Job de empacotamento (packer) ---------------------------------------
# Chave PRIVADA Ed25519 que assina os packs. Montada como volume somente
# leitura no servico `packer`, que nao abre porta — o `cms` nunca a ve.
# Em producao vive em cofre/HSM; aqui aponte para o PEM local.
PACK_SIGNING_KEY_HOST_PATH=../contract/keys/dev-k1.pem
# PACK_SIGNING_KEY_ID esta declarada no bloco da chave, acima — uma vez so.
# Num arquivo .env a ultima ocorrencia vence, entao chave repetida "funciona"
# ate alguem editar a de cima e nada mudar.
S3_BUCKET=content-packs
# Carimbo reproduzivel: sem ele, duas builds do mesmo conteudo geram hashes
# diferentes e a frota re-baixa o pack a toa.
SOURCE_DATE_EPOCH=1787097600
# Plano B (Revisao do ADR-004): de onde o app baixa o modelo, DENTRO do manifest
# assinado. Os dois juntos ou nenhum. Vazios = manifest sem `model`, e o app usa
# o MODEL_URL embarcado. A URL relativa resolve contra o manifest, e o app so a
# aceita na origem do manifest ou no host do MODEL_URL; o sha precisa ser o do
# model_catalog.dart. Ex.: ../models/gemma-3-1b-it-Q4_K_M-<sha>.gguf
PACK_MODEL_URL=
PACK_MODEL_SHA256=

# --- Host so de conteudo (plano B; compose.content.yaml) -------------------
# Diretorio do HOST servido pelo Caddy (somente leitura no container). Na VPS,
# do usuario `publisher`. A URL publica e /content-packs/<edicao>/manifest.json,
# entao a arvore fica em $CONTENT_ROOT/content-packs/<edicao>/.
CONTENT_ROOT=/srv/guia-ubs/conteudo
# Portas publicadas. Na VPS ficam 80/443; o `content:test` usa outras.
CONTENT_HTTP_PORT=80
CONTENT_HTTPS_PORT=443
# Destino do `npm run content:publish` (rsync). Remoto: `publisher@<host>:`
# (o rrsync no servidor fixa a raiz em CONTENT_ROOT). Local: um diretorio.
CONTENT_TARGET=
# Chave PUBLICA Ed25519 (hex de 64) com que o content:publish confere o
# manifest ANTES de enviar. Publica; nunca a privada.
PACK_PUBKEY_HEX=

# --- Modelo SLM (npm run model:publish; ADR-004) ---------------------------
# Base PUBLICA do bucket no edge, como o aparelho a ve. A MODEL_URL dos builds
# e esta base + /models/<nome>-<sha256>.gguf (o script imprime a URL final).
MODEL_PUBLIC_BASE_URL=https://conteudo.exemplo.invalid/content-packs
# Um manifest de pack ja publicado. Depois de mexer na politica do bucket, o
# script confere que ele continua servido: os packs nao podem parar por causa
# do modelo. Vazio = ambiente novo, sem pack a preservar (o script avisa).
MODEL_CHECK_MANIFEST_URL=
