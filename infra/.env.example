# Copie para `infra/.env` e preencha. NUNCA versione o .env real (.gitignore).
# Valores abaixo sao ficticios e servem apenas de exemplo.

# --- Borda publica ---
CONTENT_DOMAIN=conteudo.exemplo.invalid
ACME_EMAIL=ops@exemplo.invalid

# --- Storage de packs (MinIO) ---
MINIO_ROOT_USER=guiaubs
MINIO_ROOT_PASSWORD=troque-esta-senha

# --- Chave de assinatura de packs (Ed25519) ---
# SPOF critico do modelo de ameacas (PRD 4.2 / risco R4): em producao vive em
# cofre offline/HSM e a assinatura acontece somente no CI, com aprovacao.
# Em dev, gere um par descartavel:
#   openssl genpkey -algorithm ed25519 -out contract/keys/dev-k1.pem
#   openssl pkey -in contract/keys/dev-k1.pem -pubout -out contract/keys/pack-signing-k1.pub
PACK_SIGNING_KEY_PATH=./contract/keys/dev-k1.pem
PACK_SIGNING_KEY_ID=k1

# --- Plano de controle (cms) ---------------------------------------------
# Gere cada um com: openssl rand -base64 48
#
# BETTER_AUTH_SECRET cifra o segredo TOTP em repouso. Trocar este valor
# INVALIDA o segundo fator de todo mundo — nao e rotacao, e reset.
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-de-48-bytes-em-base64
# IP_HASH_SALT pseudonimiza o IP na trilha e o e-mail na trava de login. Sem
# sal, sha256 de IPv4 se inverte por forca bruta em minutos.
IP_HASH_SALT=troque-por-outro-valor-aleatorio-de-48-bytes-em-base64
# URL publica do CMS — usada na validacao de origem (CSRF).
BETTER_AUTH_URL=http://127.0.0.1:8787
