{
  "$id": "https://guia-ubs.example/contract/manifest-schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ref",
          "url",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "minAppBuild": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "municipality": {
      "minLength": 1,
      "type": "string"
    },
    "pack": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "packVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "publishedAt": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "schemaVersion": {
      "pattern": "^\\d+\\.\\d+$",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519",
          "type": "string"
        },
        "keyId": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "alg",
        "keyId",
        "value"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "packVersion",
    "municipality",
    "pack",
    "assets",
    "minAppBuild",
    "publishedAt",
    "signature"
  ],
  "title": "Guia UBS pack manifest",
  "type": "object"
}
