{
  "name": "guia-ubs",
  "version": "0.1.0",
  "private": true,
  "description": "Guia UBS — monorepo do plano de controle de conteudo (contract, cms, packer)",
  "license": "MIT",
  "workspaces": [
    "contract",
    "cms",
    "cms/web",
    "packer"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contract:generate": "npm --workspace contract run generate",
    "contract:check": "npm run contract:generate && git diff --exit-code contract/",
    "typecheck": "tsc --noEmit -p contract && tsc --noEmit -p cms && tsc --noEmit -p cms/web && tsc --noEmit -p packer",
    "cms:generate": "npm --workspace @guia-ubs/cms run db:generate",
    "cms:triggers": "npm --workspace @guia-ubs/cms run db:triggers",
    "cms:migrate": "npm --workspace @guia-ubs/cms run db:migrate",
    "cms:create-admin": "npm --workspace @guia-ubs/cms run create-admin --",
    "cms:import-golden": "npm --workspace @guia-ubs/cms run import-golden --",
    "cms:register-key": "npm --workspace @guia-ubs/cms run register-signing-key --",
    "cms:check": "npm run cms:generate && npm run cms:triggers && git add --intent-to-add --all cms/ && git diff --exit-code -- cms/",
    "cms:dev": "npm --workspace @guia-ubs/cms run dev",
    "web:dev": "npm --workspace @guia-ubs/cms-web run dev",
    "web:build": "npm --workspace @guia-ubs/cms-web run build",
    "web:test": "npm --workspace @guia-ubs/cms-web run test",
    "infra:validate": "docker compose -f infra/compose.yaml config --quiet",
    "test": "npm --workspaces --if-present run test",
    "pack:build": "npm --workspace @guia-ubs/packer run build:pack",
    "pack:publish": "npm --workspace @guia-ubs/packer run publish:pack",
    "pack:check": "npm --workspace @guia-ubs/packer run build:pack:dry",
    "pack:worker": "npm --workspace @guia-ubs/packer run worker --"
  }
}
