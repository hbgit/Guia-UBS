# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Classes de i18n geradas a partir de lib/l10n/*.arb. Sao reproduzidas por
# `flutter pub get` (flutter: generate: true), entao versiona-las so criaria
# conflito de merge em arquivo que ninguem edita.
lib/l10n/app_localizations*.dart

# Codigo gerado pelo Drift (build_runner). Reproduzido por
# `dart run build_runner build`; versiona-lo so criaria conflito de merge em
# arquivo que ninguem edita.
*.g.dart

# Defines do build (MODEL_URL etc.), um por ambiente. O de debug e o de profile
# ficam fora do git. O de RELEASE e versionado: o conteudo vai embarcado num APK
# publico, e versionado ele passa por PR e todo mundo sabe o que o ultimo
# release embarcou (ADR-009). O modelo continua em config/defines.example.json.
config/defines.*.json
!config/defines.example.json
!config/defines.release.json
